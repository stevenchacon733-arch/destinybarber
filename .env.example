# Local dev: SQLite. En Vercel, usa una URL de Postgres (ver README) y cambia el provider en prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Genera uno propio (no reutilices este valor): node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="reemplaza-esto-con-un-valor-aleatorio-largo"

# Zona horaria real del local — importante para que "hoy" y los horarios se calculen bien en el servidor.
TZ="America/Santiago"
